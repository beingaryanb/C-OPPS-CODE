
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main()
{
    vector<int> v = {40, 10, 30, 20};

    cout << "Original Elements: ";
    for (auto it = v.begin(); it != v.end(); it++)
        cout << *it << " ";

    sort(v.begin(), v.end());

    cout << "\nSorted Elements: ";
    for (auto it = v.begin(); it != v.end(); it++)
        cout << *it << " ";

    cout << "\nSize: " << v.size();

    return 0;
}
