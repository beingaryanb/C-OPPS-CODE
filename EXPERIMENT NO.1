
#include <iostream>
using namespace std;

int main()
{
    // Variables and data types
    int a = 10, b = 5;
    float x = 5.5;
    char grade = 'A';
    const float PI = 3.14;

    // Input and Output
    int num;
    cout << "Enter a number: ";
    cin >> num;

    cout << "Integer: " << a << endl;
    cout << "Float: " << x << endl;
    cout << "Character: " << grade << endl;
    cout << "Constant PI: " << PI << endl;

    // Operators
    cout << "Addition: " << a + b << endl;
    cout << "Subtraction: " << a - b << endl;
    cout << "Multiplication: " << a * b << endl;
    cout << "Division: " << a / b << endl;
    cout << "Entered number: " << num << endl;

    return 0;
}
